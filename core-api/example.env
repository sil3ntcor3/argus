# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
OASM_CLOUD_APIKEY=change_me
REDIS_URL=redis://:password@localhost:6379/0

GEO_IP_URL=localhost:4360

# Deployed auth requires a random secret of at least 32 characters. Generate it
# with openssl rand -base64 32. Changing it invalidates existing signed cookies.
BETTER_AUTH_SECRET=

# Public console origin, e.g. https://argus.example.com (no /api suffix).
# Used by auth and Telegram webhooks; leave empty for local request-host
# auth fallback and Telegram polling. Takes precedence over auth URL aliases.
BASE_URL=

# Envelope encryption: last key encrypts, earlier keys only decrypt. Outside
# development/test the active key must be 32+ characters and not an example.
# Append a new random key to rotate. Legacy OASM keys remain readable; boot
# rewrites recognized stored credentials as authenticated AES-256-GCM. Retain
# older keys and a pre-upgrade database backup until verification is complete.
ENCRYPTION_KEYS=your-encryption-key-change-in-production

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Audit log retention: directory where expired audit rows are archived to
# per-day JSONL files before deletion (defaults to ./audit-archive)
AUDIT_ARCHIVE_DIR=./audit-archive

# Reverse proxies in front of core-api (comma-separated IPs/CIDRs). Their
# X-Forwarded-For hops are skipped to find the real client IP (auth rate limit,
# worker IP, HTTP audit source IP). Leave empty when clients connect directly.
# Example behind nginx/cloudflared in Docker: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
